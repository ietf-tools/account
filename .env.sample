# ─────────────────────────────────────────────────────────────────────────────
# Backend (Fastify)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=4000

# Path prefix the API is served under. Leave as "/api" for local dev (the Nuxt
# dev proxy targets it directly). In the account.ietf.org production deployment
# the app is mounted at /app and authentik owns the root /api, so set this to
# "/app/api" and have the reverse proxy forward /app/api/* WITHOUT stripping the
# prefix.
API_PREFIX=/api

# URL the frontend is served from. Used for CORS in dev (prod is same-origin).
FRONTEND_URL=http://localhost:3000

# Secret used to sign the session cookie. Only the legacy-migration handoff is
# kept server-side (auth is driven browser->authentik directly). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Set to "true" behind an HTTPS-terminating proxy in production.
SESSION_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# authentik (headless / API driven)
# ─────────────────────────────────────────────────────────────────────────────
# Base URL of your authentik install (no trailing slash). In production the app
# is deployed on the same host, so the browser reaches authentik at same-origin
# /api/v3. In dev this URL is what the Nuxt dev proxy forwards /api/v3 -> (so the
# browser can drive flows from localhost).
AUTHENTIK_URL=https://auth.example.com

# API token for a service account with permission to read/create users.
# authentik: Directory > Tokens & App passwords (or a service account token).
# Only used for backend-driven flows like the legacy account migration.
AUTHENTIK_API_TOKEN=

# Flow slugs the SPA drives directly via authentik's Flow Executor. These are the
# authentik default slugs — override to match your brand's configured flows.
# (Read by nuxt.config.ts and shipped to the browser as public runtime config.)
AUTHENTIK_FLOW_AUTHENTICATION=ietf-login
AUTHENTIK_FLOW_ENROLLMENT=ietf-enrollment
AUTHENTIK_FLOW_RECOVERY=ietf-recovery
AUTHENTIK_FLOW_USER_SETTINGS=ietf-user-settings-flow
AUTHENTIK_FLOW_PASSWORD_CHANGE=ietf-password-change
AUTHENTIK_FLOW_TOTP_SETUP=default-authenticator-totp-setup
AUTHENTIK_FLOW_WEBAUTHN_SETUP=default-authenticator-webauthn-setup
AUTHENTIK_FLOW_STATIC_SETUP=default-authenticator-static-setup

# ─────────────────────────────────────────────────────────────────────────────
# Legacy Django system (used only by the account migration flow)
# ─────────────────────────────────────────────────────────────────────────────
# Base URL of the legacy system's API used to verify old credentials.
LEGACY_API_URL=
LEGACY_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Avatar uploads (S3-compatible object storage — AWS S3, MinIO, …)
# ─────────────────────────────────────────────────────────────────────────────
# Only needed for the "upload your own picture" option; Gravatar mode works
# without it. Uploaded images are stored as objects and their URL (not the bytes)
# is written to the authentik user, so the OIDC `picture` claim other apps consume
# stays small and cacheable. Also: set authentik AVATARS to
# `attributes.avatar,gravatar,initials` and map `picture` = request.user.avatar.
#
# Leave AVATAR_S3_ENDPOINT blank for AWS S3; set it for MinIO/other S3-compatibles.
# AVATAR_S3_ENDPOINT=https://minio.example.com
AVATAR_S3_REGION=us-east-1
AVATAR_S3_BUCKET=
AVATAR_S3_ACCESS_KEY_ID=
AVATAR_S3_SECRET_ACCESS_KEY=
# Public base URL the stored objects are served from (bucket public URL or a CDN
# in front of it). The object key is appended to this.
AVATAR_S3_PUBLIC_URL=
# Optional overrides:
# AVATAR_S3_KEY_PREFIX=avatars/
# AVATAR_S3_FORCE_PATH_STYLE=true   # defaults on when AVATAR_S3_ENDPOINT is set

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Nuxt) — only needed to override defaults
# ─────────────────────────────────────────────────────────────────────────────
# In dev the frontend proxies the app API (…/app/api) to this backend. In prod
# the SPA is served by the backend so it's same-origin and this is unused.
# NUXT_BACKEND_URL=http://localhost:4000

# authentik's API base as seen by the browser. Default "/api/v3" (same-origin in
# prod; proxied to AUTHENTIK_URL in dev). Override only for an unusual mount.
# NUXT_PUBLIC_AUTHENTIK_API_URL=/api/v3
